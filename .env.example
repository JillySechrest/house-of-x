# Demo mode (default): the local mock gateway serving sample fixtures.
# These are throwaway demo keys, not real credentials.
MARVEL_BASE_URL=http://localhost:8001/v1/public
MARVEL_PUBLIC_KEY=demo-public-key
MARVEL_PRIVATE_KEY=demo-private-key

# Real Marvel mode: leave MARVEL_BASE_URL empty (defaults to
# https://gateway.marvel.com/v1/public) and put your own keys above.
